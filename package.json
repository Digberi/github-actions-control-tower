{
  "name": "github-actions-control-tower",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lecture 32: observable GitHub Actions CI/CD demo with real gates and controlled failures",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "check:syntax": "node scripts/gates.mjs syntax",
    "check:architecture": "node scripts/gates.mjs architecture",
    "check:depgraph": "node scripts/depgraph-check.mjs green",
    "demo:depgraph:red": "node scripts/depgraph-check.mjs red",
    "check:contract": "node scripts/gates.mjs contract",
    "check:secrets": "node scripts/gates.mjs secrets",
    "check:workflows": "node scripts/gates.mjs workflows",
    "check:performance": "node scripts/gates.mjs performance",
    "test:unit": "node --test tests/unit.test.mjs",
    "check:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 tests/unit.test.mjs",
    "check:sbom": "npm sbom --sbom-format cyclonedx | node scripts/verify-sbom.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:consumer": "node --test tests/consumer.test.mjs",
    "test:pact:green": "node scripts/pact-contract.mjs green",
    "test:pact:red": "node scripts/pact-contract.mjs red",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "check:platform": "node scripts/platform-check.mjs",
    "quality:bootstrap": "npm ci --ignore-scripts",
    "check:style": "node scripts/quality-check.mjs G03 green",
    "check:types:demo": "node scripts/quality-check.mjs G04 green",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run check:syntax && npm run check:architecture && npm run check:depgraph && npm run check:contract && npm run check:secrets && npm test && npm run check:performance",
    "demo:happy": "node scripts/demo.mjs happy",
    "demo:unit": "node scripts/demo.mjs unit",
    "demo:integration": "node scripts/demo.mjs integration",
    "demo:contract": "node scripts/demo.mjs contract",
    "demo:architecture": "node scripts/demo.mjs architecture",
    "demo:security": "node scripts/demo.mjs security",
    "demo:performance": "node scripts/demo.mjs performance",
    "demo:preflight": "node scripts/demo-controller.mjs preflight",
    "demo:list": "node scripts/demo-controller.mjs list",
    "demo:case": "node scripts/demo-controller.mjs case",
    "demo:show": "node scripts/demo-controller.mjs show",
    "demo:report": "node scripts/demo-controller.mjs report",
    "demo:cleanup": "node scripts/demo-controller.mjs cleanup",
    "check:heavy": "node scripts/heavy-gates.mjs G13 green && node scripts/heavy-gates.mjs G19 green && node scripts/heavy-gates.mjs G20 green && node scripts/heavy-gates.mjs G24 green && node scripts/heavy-gates.mjs G26 green && node scripts/heavy-gates.mjs G27 green",
    "test:postgres": "PG_REQUIRED=1 node --test tests/postgres.test.mjs",
    "check:types": "tsc --noEmit --project quality/types/tsconfig.src.json",
    "test:property": "node --test tests/property.test.mjs",
    "nightly:soak": "node scripts/soak.mjs 20",
    "nightly:mutation": "node scripts/mutation-proof.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@pact-foundation/pact": "17.1.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
