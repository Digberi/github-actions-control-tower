{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": { "name": "orders-api", "namespace": "lecture-cicd" },
  "spec": {
    "replicas": 1,
    "selector": { "matchLabels": { "app": "orders-api" } },
    "template": {
      "metadata": { "labels": { "app": "orders-api" } },
      "spec": {
        "securityContext": { "runAsNonRoot": false },
        "containers": [{
          "name": "orders-api",
          "image": "ghcr.io/digberi/github-actions-control-tower:latest",
          "ports": [{ "containerPort": 3000 }],
          "securityContext": { "privileged": true, "allowPrivilegeEscalation": true }
        }]
      }
    }
  }
}
