{
  "openapi": "3.0.3",
  "info": { "title": "Control Tower Orders", "version": "1.1.0" },
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["items"],
                "properties": {
                  "items": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created with broken contract",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "totalCents"],
                  "properties": {
                    "status": { "type": "string" },
                    "totalCents": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
